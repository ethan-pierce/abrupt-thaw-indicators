data/*.nc
data/*.tif
# Compiled Python (any directory)
__pycache__/
*.pyc
# macOS Finder metadata
.DS_Store
# Scratchpad run logs (build/train `tee` output) — transient, never tracked
scratchpad_*.log
data/Obu2019
# ALFRESCO historical rasters — regenerate with data/fetch_alfresco.py
data/alfresco/*.tif
# Daymet V4 reductions raster — regenerate with data/build_daymet_rasters.py
data/daymet/*.tif
# MODIS MCD64A1 fire-history raster — regenerate with data/build_modis_fire_rasters.py
data/modis_fire/*.tif
# NLCD 2016 Alaska (ERDAS IMAGINE .img + .ige spill file) — large local download
data/NLCD2016
# IRYP v2 yedoma confidence shapefile (T33) — large in-repo source download
data/IRYP_v2_yedoma_confidence_Shapefile
# Circumpolar Thermokarst Landscapes (Olefeldt 2016) — large in-repo source download
data/Circumpolar_Thermokarst_Landscapes

# Non-authoritative SHAP-group smoke outputs
output/_smoke/

# Derived per-figure TreeSHAP / region-assignment caches — regenerated by the
# figure scripts on first run
output/*_cache.npz

# Field photos: track only the two production files used by Fig 1; sources/unused stay local
data/photos/*
!data/photos/thaw-slump-overeem.png
!data/photos/thermokarst-lake-rozmiarek.jpg

# Fig 1 schematic raster intermediate — regenerated by output/fig01_process_schematic.py
output/*_600dpi.png
